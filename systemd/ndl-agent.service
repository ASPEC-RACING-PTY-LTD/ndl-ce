[Unit]
Description=No-dal node agent
After=ndl-agent.socket
Requires=ndl-agent.socket
Documentation=https://no-dal.com
# Workloads must not use BindsTo, PartOf, or Requires against this unit.

[Service]
# Type=simple until the agent calls sd_notify READY=1 from Go.
# Switch to Type=notify when that lands.
Type=simple
User=root
ExecStart=/usr/sbin/ndl-agent
Restart=on-failure
RestartSec=2
# The socket unit owns /run/ndl. Do not set RuntimeDirectory=ndl here;
# a service restart would delete agent.sock.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
DevicePolicy=closed
# CAP_NET_ADMIN is required for isolated-nat nftables.
# CAP_CHOWN remaps unprivileged container rootfs onto the persisted uid map.
# File and networkd drop-in writes do not need extra capabilities.
# ExecStop must not stop guest workload units.

[Install]
WantedBy=multi-user.target
