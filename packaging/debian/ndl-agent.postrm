#!/bin/sh
set -e

# apt remove stops the agent and its socket. It does not delete
# /var/lib/ndl or workload data. Do not stop on upgrade; unpack can
# keep the running agent until dh_installsystemd restarts it once.

stop_units() {
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl stop ndl-agent.service ndl-agent.socket >/dev/null 2>&1 || true
  fi
}

case "$1" in
  remove|deconfigure)
    stop_units
    ;;
esac

# The shell profile link points into this package; remove it with it.
case "$1" in
  remove|purge)
    if [ -L /etc/profile.d/ndl-shell.sh ] && [ "$(readlink /etc/profile.d/ndl-shell.sh)" = /usr/share/ndl/profile/ndl-shell.sh ]; then
      rm -f /etc/profile.d/ndl-shell.sh
    fi
    ;;
esac

#DEBHELPER#

exit 0
