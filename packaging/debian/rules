#!/usr/bin/make -f

# Build from the Go module root. debian/ lives at packaging/debian.
export DH_VERBOSE = 1
export GO111MODULE = on
export CGO_ENABLED = 0

MODROOT := $(abspath $(dir $(firstword $(MAKEFILE_LIST)))/../..)
ifeq ($(wildcard $(MODROOT)/cmd/ndl-control),)
MODROOT := $(CURDIR)
endif
ifeq ($(wildcard $(MODROOT)/cmd/ndl-control),)
MODROOT := $(abspath $(CURDIR)/..)
endif

ifeq ($(wildcard $(CURDIR)/cmd/ndl-control),$(CURDIR)/cmd/ndl-control)
GO_CD :=
GO_OUT :=
else
GO_CD := cd $(MODROOT) &&
GO_OUT := $(CURDIR)/
endif

HELPER := $(MODROOT)/packaging/lib/ndl/postinst-control.sh

%:
	dh $@

override_dh_auto_clean:
	rm -rf debian/tmp build
	rm -rf $(MODROOT)/ui/dist
	rm -f debian/ndl-control.service debian/ndl-agent.service debian/ndl-agent.socket

override_dh_auto_build:
	mkdir -p build
	$(GO_CD) go build -o $(GO_OUT)build/ndl-control ./cmd/ndl-control
	$(GO_CD) go build -o $(GO_OUT)build/ndl-agent ./cmd/ndl-agent
	$(GO_CD) go build -o $(GO_OUT)build/nodalctl ./cmd/nodalctl
	$(GO_CD) go build -o $(GO_OUT)build/ndl-network-rollback ./cmd/ndl-network-rollback
	$(GO_CD) go build -o $(GO_OUT)build/ndl-qemu-launch ./cmd/ndl-qemu-launch
	$(GO_CD) go build -o $(GO_OUT)build/ndl-oci-launch ./cmd/ndl-oci-launch
	$(GO_CD) go build -o $(GO_OUT)build/ndl-guest ./cmd/ndl-guest
	sh $(MODROOT)/packaging/lib/ndl/build-ui.sh $(MODROOT)/ui

override_dh_auto_test:
	true

override_dh_auto_install:
	mkdir -p debian/tmp/usr/sbin debian/tmp/usr/bin debian/tmp/usr/lib/ndl
	mkdir -p debian/tmp/lib/systemd/system
	mkdir -p debian/tmp/etc/apparmor.d/local
	install -m 0755 build/ndl-control debian/tmp/usr/sbin/ndl-control
	install -m 0755 build/ndl-agent debian/tmp/usr/sbin/ndl-agent
	install -m 0755 build/ndl-qemu-launch debian/tmp/usr/sbin/ndl-qemu-launch
	install -m 0755 build/ndl-oci-launch debian/tmp/usr/sbin/ndl-oci-launch
	install -m 0755 build/ndl-guest debian/tmp/usr/sbin/ndl-guest
	install -m 0755 build/ndl-network-rollback debian/tmp/usr/lib/ndl/ndl-network-rollback
	install -m 0755 build/nodalctl debian/tmp/usr/bin/nodalctl
	test -f $(MODROOT)/ui/dist/index.html
	test -d $(MODROOT)/ui/dist/assets
	mkdir -p debian/tmp/usr/share/ndl/ui
	cp -a $(MODROOT)/ui/dist/. debian/tmp/usr/share/ndl/ui/
	install -m 0755 $(HELPER) debian/tmp/usr/lib/ndl/postinst-control.sh
	install -m 0644 $(MODROOT)/systemd/ndl-control.service debian/tmp/lib/systemd/system/ndl-control.service
	install -m 0644 $(MODROOT)/systemd/ndl-agent.service debian/tmp/lib/systemd/system/ndl-agent.service
	install -m 0644 $(MODROOT)/systemd/ndl-agent.socket debian/tmp/lib/systemd/system/ndl-agent.socket
	install -m 0644 $(MODROOT)/systemd/nodal-workloads.target debian/tmp/lib/systemd/system/nodal-workloads.target
	install -m 0644 $(MODROOT)/systemd/ndl-network-rollback.service debian/tmp/lib/systemd/system/ndl-network-rollback.service
	install -m 0644 $(MODROOT)/systemd/ndl-dnsmasq@.service debian/tmp/lib/systemd/system/ndl-dnsmasq@.service
	install -m 0644 $(MODROOT)/systemd/ndl-nat@.service debian/tmp/lib/systemd/system/ndl-nat@.service
	install -m 0644 $(MODROOT)/systemd/nodal-ct@.service debian/tmp/lib/systemd/system/nodal-ct@.service
	install -m 0644 $(MODROOT)/systemd/nodal-vm@.service debian/tmp/lib/systemd/system/nodal-vm@.service
	install -m 0644 $(MODROOT)/systemd/nodal-oci@.service debian/tmp/lib/systemd/system/nodal-oci@.service
	install -m 0644 $(MODROOT)/systemd/ndl-guest.service debian/tmp/lib/systemd/system/ndl-guest.service
	install -m 0644 $(MODROOT)/packaging/apparmor/usr.bin.qemu-system-x86_64.local debian/tmp/etc/apparmor.d/local/usr.bin.qemu-system-x86_64
	mkdir -p debian/tmp/usr/share/ndl/features
	install -m 0644 $(MODROOT)/packaging/share/ndl/features/oci debian/tmp/usr/share/ndl/features/oci
	install -m 0644 $(MODROOT)/packaging/share/ndl/features/gpu debian/tmp/usr/share/ndl/features/gpu
	install -m 0644 $(MODROOT)/packaging/share/ndl/features/k8s debian/tmp/usr/share/ndl/features/k8s
	install -m 0644 $(MODROOT)/packaging/share/ndl/features/distributed-storage debian/tmp/usr/share/ndl/features/distributed-storage
	install -m 0644 $(MODROOT)/packaging/share/ndl/features/ai debian/tmp/usr/share/ndl/features/ai

override_dh_install:
	dh_install
	test -f debian/ndl-ui/usr/share/ndl/ui/index.html
	test -d debian/ndl-ui/usr/share/ndl/ui/assets

override_dh_dwz:
	true

override_dh_strip:
	true

override_dh_installsystemd:
	cp -f $(MODROOT)/systemd/ndl-control.service debian/ndl-control.service
	cp -f $(MODROOT)/systemd/ndl-agent.service debian/ndl-agent.service
	cp -f $(MODROOT)/systemd/ndl-agent.socket debian/ndl-agent.socket
	dh_installsystemd -pndl-control --name=ndl-control
	dh_installsystemd -pndl-agent --name=ndl-agent
