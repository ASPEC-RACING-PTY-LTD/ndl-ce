#!/bin/sh
set -e

# apt remove stops services. It does not delete /var/lib/ndl,
# PostgreSQL data, or workload disks. apt purge may remove /etc/ndl
# config written by postinst. Data wipe is a separate explicit command.
# Do not stop ndl-control on upgrade. dh_installsystemd keeps the old
# process running until the automatic systemd helper in postinst
# restarts it once. Stopping here plus starting in postinst plus that
# helper causes extra stop/start cycles during package install.

stop_unit() {
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl stop ndl-control.service >/dev/null 2>&1 || true
  fi
}

case "$1" in
  remove|deconfigure)
    stop_unit
    ;;
  purge)
    rm -f /etc/ndl/control.env
    rmdir /etc/ndl 2>/dev/null || true
    # Keep /var/lib/ndl and the nodal database.
    ;;
esac

#DEBHELPER#

exit 0
